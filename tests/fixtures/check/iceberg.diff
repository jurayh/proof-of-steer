index 0000000..02fa101
--- /dev/null
+++ b/IceBerg/src/index.css
@@ -0,0 +1,124 @@
+*, *::before, *::after {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+:root {
+  --gold-100: #fffbf0;
+  --gold-200: #fef3c7;
+  --gold-300: #fcd34d;
+  --gold-400: #f59e0b;
+  --gold-500: #d97706;
+  --gold-600: #b45309;
+  --amber-deep: #78350f;
+  --ember:      #92400e;
+
+  --text-primary:   #1c0a00;
+  --text-secondary: #6b3a12;
+  --text-muted:     #a16207;
+
+  --surface:        rgba(255, 251, 240, 0.6);
+  --surface-solid:  #fffbf0;
+
+  --border: rgba(245, 158, 11, 0.25);
+
+  --font-hero:    "Playfair Display", Georgia, serif;
+  --font-display: "Cormorant Garamond", Georgia, serif;
+  --font-body:    "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+
+  --transition: 200ms ease;
+}
+
+html, body, #root {
+  height: 100%;
+}
+
+body {
+  font-family: var(--font-body);
+  color: var(--text-primary);
+  background: var(--gold-100);
+  background-image:
+    radial-gradient(ellipse 60% 70% at 50% 50%, rgba(251, 191, 36, 0.18) 0%, transparent 70%),
+    radial-gradient(ellipse 100% 100% at 50% -10%, rgba(245, 158, 11, 0.12) 0%, transparent 60%);
+}
+
+/* Shared page header (timelines + connections) */
+.page-header {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 1rem;
+  padding: 2rem 3rem 1.5rem;
+  border-bottom: 1px solid var(--border);
+  position: sticky;
+  top: 0;
+  background: rgba(255, 251, 240, 0.92);
+  backdrop-filter: blur(10px);
+  z-index: 20;
+}
+
+.page-back {
+  font-size: 0.8rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--text-muted);
