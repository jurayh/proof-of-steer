@@ -0,0 +1,230 @@
+.tl-page {
+  min-height: 100vh;
+  background: var(--gold-100);
+  background-image:
+    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(251, 191, 36, 0.14) 0%, transparent 60%);
+  color: var(--text-primary);
+  font-family: var(--font-body);
+  overflow-y: auto;
+  overflow-x: hidden;
+}
+
+.tl-compare-toggle {
+  justify-self: end;
+  padding: 0.45rem 1rem;
+  background: transparent;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  font-size: 0.75rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  color: var(--text-secondary);
+  cursor: pointer;
+  transition: border-color var(--transition), color var(--transition);
+}
+
+.tl-compare-toggle:hover {
+  border-color: var(--gold-400);
+  color: var(--gold-600);
+}
+
+/* ── Comparison table ───────────────────────────────── */
+.tl-comparison {
+  padding: 1.5rem 3rem;
+  border-bottom: 1px solid var(--border);
+  overflow-x: auto;
+}
+
+.compare-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 0.85rem;
+}
+
+.compare-table th,
+.compare-table td {
+  padding: 0.6rem 1rem;
+  text-align: left;
+  border-bottom: 1px solid var(--border);
+  line-height: 1.5;
+}
+
+.compare-table thead th {
+  font-size: 0.7rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  font-weight: 600;
+  padding-bottom: 0.75rem;
+}
+
+.col-aspect { width: 18%; }
+.col-a      { width: 41%; }
+.col-b      { width: 41%; }
+
+.cell-aspect {
+  font-size: 0.72rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.cell-a { color: var(--text-secondary); }
+.cell-b { color: var(--text-secondary); }
+.col-a, .cell-a { border-right: 1px solid var(--border); }
+
+/* ── Timeline grid ──────────────────────────────────── */
+.tl-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0;
+  padding: 2.5rem 3rem 4rem;
+  max-width: 1280px;
+  margin: 0 auto;
+}
+
+.tl-column { padding: 0 1.5rem; }
+.tl-column + .tl-column { border-left: 1px solid var(--border); }
+
+/* ── Column header ──────────────────────────────────── */
+.tl-col-header {
+  display: flex;
+  align-items: flex-start;
+  gap: 1rem;
+  margin-bottom: 2rem;
+  padding-bottom: 1.25rem;
+  border-bottom: 1px solid var(--border);
+}
+
+.tl-eye-dot {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  margin-top: 0.35rem;
+  flex-shrink: 0;
+  box-shadow: 0 0 10px currentColor;
+}
+
+.tl-col-label {
+  font-family: var(--font-display);
+  font-size: 1.5rem;
+  font-weight: 300;
+  color: var(--amber-deep);
+  letter-spacing: 0.04em;
+  line-height: 1;
+  margin-bottom: 0.2rem;
+}
+
+.tl-col-eyebrow {
+  font-size: 0.68rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  margin-bottom: 0.25rem;
+}
+
+.tl-col-descriptor {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 0.9rem;
+  color: var(--text-secondary);
+}
+
+/* ── Beat cards ─────────────────────────────────────── */
+.beats-list {
+  display: flex;
+  flex-direction: column;
+  gap: 0.5rem;
+}
+
+.beat-card {
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: rgba(255, 251, 240, 0.5);
+  overflow: hidden;
+  transition: border-color var(--transition), background var(--transition);
+}
+
+.beat-card.is-open {
+  background: rgba(255, 251, 240, 0.95);
+  border-color: rgba(245, 158, 11, 0.45);
+}
+
+.beat-header {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.75rem 1rem;
+  background: transparent;
+  border: none;
+  cursor: pointer;
+  text-align: left;
+  font-family: var(--font-body);
+}
+
+.beat-index {
+  font-size: 0.65rem;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  color: var(--text-muted);
+  flex-shrink: 0;
+  width: 1.5rem;
+}
+
+.beat-title {
+  font-size: 0.875rem;
+  font-weight: 600;
+  color: var(--amber-deep);
+  flex: 1;
+  text-transform: capitalize;
+}
+
+.beat-chevron {
+  font-size: 1rem;
+  color: var(--gold-500);
+  flex-shrink: 0;
+  line-height: 1;
+}
+
+.beat-summary {
+  padding: 0 1rem 0.75rem calc(0.75rem + 1.5rem + 1rem);
+  font-size: 0.82rem;
+  color: var(--text-secondary);
+  line-height: 1.6;
+}
+
+.beat-detail {
+  padding: 0.75rem 1rem 1rem calc(0.75rem + 1.5rem + 1rem);
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 0.875rem;
+  line-height: 1.75;
+  color: var(--text-primary);
+  border-top: 1px solid var(--border);
+}
+
+@media (max-width: 768px) {
+  .tl-compare-toggle { justify-self: center; }
+
+  .tl-grid {
+    grid-template-columns: 1fr;
+    padding: 1.5rem;
+  }
+
+  .tl-column + .tl-column {
+    border-left: none;
+    border-top: 1px solid var(--border);
+    margin-top: 2rem;
+    padding-top: 2rem;
+  }
+
+  .tl-comparison { padding: 1rem 1.5rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .beat-card { transition: none; }
+}
