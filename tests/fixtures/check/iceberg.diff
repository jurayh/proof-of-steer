+import { createSignal, For, Show } from 'solid-js'
+import { A } from '@solidjs/router'
+import '../connections.css'
+
+type Presence = 'a' | 'b' | 'both'
+type Bond = 'divine' | 'adversary' | 'family' | 'ally' | 'ward' | 'child'
+
+interface Connection {
+  name: string
+  title: string
+  presence: Presence
+  bond: Bond
+  eyeA?: string
+  eyeB?: string
+  summaryA?: string
+  summaryB?: string
+  quote?: string
+  quoteSource?: string
+}
+
+const connections: Connection[] = [
+  {
+    name: 'YHWH',
+    title: 'The Creator — Mother',
+    presence: 'both',
+    bond: 'divine',
+    summaryA: 'Uriel serves her without question as judge and Guardian. After the judgment of Cain, YHWH withdraws from creation. Uriel remains at her post. The system holds.',
+    summaryB: 'She judges Uriel after Eden — exile, sword taken, forbidden to teach. After the sentence, their eyes meet. Warmth. Recognition. Not forgiveness. Presence.',
+    quote: 'Something small and warm lives in Uriel\'s marrow, in a place Lucifer did not think to reach. YHWH\'s warmth, brushing against the edges of the design.',
+  },
+  {
+    name: 'Lucifer',
+    title: 'Co-creator — The Architect of Her Function',
+    presence: 'both',
+    bond: 'divine',
+    summaryA: 'He shaped her: Observer. Recorder. Neutral. Three words woven into her sinew. After the council, no significant contact. The distance is structural — she is his design, not his confidant.',
+    summaryB: 'He finds her on the periphery and offers her a side in the war. She agrees on one condition: the humans survive. He promises. On the battlefield she falls — and he does not save her.',
+    quote: '"Neutrality is no longer available."',
+  },
+  {
+    name: 'Metatron',
+    title: 'Keeper of the Akashic Records — Fellow Steward',
+    presence: 'a',
+    bond: 'ally',
+    summaryA: 'Metatron proposes the Grigori mission. Uriel is assigned to assemble the team. She reviews Gabriel, Raphael, Michael — finds them each wrong for the work, and recognises herself as the correct instrument. The mission is never approved. The gap in the archive remains.',
+  },
+  {
+    name: 'Michael',
+    title: 'Steward of Heaven — Fortitude & Justice',
+    presence: 'both',
+    bond: 'ally',
+    summaryA: 'They serve together among the five Stewards. Both hold virtues of justice. They are not close — they operate in different registers. Parallel rather than intertwined.',
+    summaryB: 'Enemies on the battlefield. He wounds her, or she wounds him — the record is unclear. She hesitates before striking an angel she once worked beside. That hesitation costs her everything.',
+  },
+  {
+    name: 'Gabriel',
+    title: 'Steward of Heaven — Faith & Kindness',
+    presence: 'both',
+    bond: 'ally',
+    summaryA: 'Fellow Steward. Uriel considers him for the Grigori mission — extensive human contact, reliable, precise. But his nature is motion: arrive, deliver, depart. He cannot stay. She does not choose him.',
+    summaryB: 'He carries Lucifer\'s message to Hell. He tells Lucifer about Uriel\'s judgment. He does not speak to her directly.',
+  },
+  {
+    name: 'Raphael',
+    title: 'Steward of Heaven — Temperance & Healing',
+    presence: 'a',
+    bond: 'ally',
+    summaryA: 'Fellow Steward. Uriel considers him for the Grigori mission. His first instinct when confronted with suffering is to mend. Glorious — and catastrophic for a mission defined by non-interference. She does not choose him.',
+  },
+  {
+    name: 'Eve',
+    title: 'First Woman — Daughter of Eden',
+    presence: 'a',
+    bond: 'ward',
+    summaryA: 'Uriel watches her from the gate. Eve looks at the forbidden tree not with hunger but with questions — why is this one forbidden? Uriel recognises herself. She does not intervene. The small, warm pressure in her chest becomes recognition.',
+  },
+  {
+    name: 'Eve',
+    title: 'First Woman — Mother-in-law',
+    presence: 'b',
+    bond: 'family',
+    summaryB: 'Uriel teaches her as the Green Vine Snake. Eve eats with her eyes open. Years later, in the settlement, Eve recognises her. She does not accuse. She thanks her.',
+    quote: '"Daughters do what they must. Even when it costs them everything."',
+    quoteSource: 'Eve, to Uriel — Timeline B',
+  },
+  {
+    name: 'Abel',
+    title: 'Shepherd — Husband',
+    presence: 'both',
+    bond: 'family',
+    summaryA: 'Uriel receives his soul at the gate. She judges him clean and admits him to Eden. She does not know him as a person. He is a record. Filed.',
+    summaryB: 'He finds her broken in a field — too thin, too still, her clothes in rags. He does not ask who she is or what she has done. He brings bread. He carries water. He is the father of her four children. He chooses to die rather than break the fixed point. She grieves him for the rest of her life.',
+    quote: '"You\'re the reason I exist at all."',
+    quoteSource: 'Abel, to Uriel — Timeline B',
+  },
+  {
+    name: 'Cain',
+    title: 'Firstborn of Adam & Eve — The Wanderer',
+    presence: 'both',
+    bond: 'ward',
+    summaryA: 'She descends to pronounce judgment. She tells him the truth: there was no chosen, the peace on Abel\'s face was contentment not favour, he mistook ease for election. She curses him, marks him for protection, and lets him walk into the forest.',
+    summaryB: 'Brother-in-law. The one who kills Abel. Uriel does not kill him. She knows YHWH will handle it. She washes Abel\'s blood from her hands.',
+    quote: '"The ground will not yield for you. You will be a fugitive and a wanderer, marked by what you have done, forever moving, forever alone."',
+    quoteSource: 'Uriel\'s judgment of Cain — Timeline A',
+  },
+  {
+    name: 'Adam',
+    title: 'First Man — Father-in-law',
+    presence: 'b',
+    bond: 'family',
+    summaryB: 'He accepts Uriel into the settlement without question or condition. His welcome is simple and absolute.',
+    quote: '"If he brought you here, you belong here."',
+    quoteSource: 'Adam, to Uriel — Timeline B',
+  },
+  {
+    name: 'Ariel',
+    title: 'Daughter — Lion of God',
+    presence: 'b',
+    bond: 'child',
+    summaryB: 'Firstborn. She watches everything, remembers her father. Uriel sees herself in Ariel\'s stillness — the same quality of attention, the same refusal to look away. She is her mother\'s daughter in the way that matters most.',
+  },
+  {
+    name: 'John',
+    title: 'Son — God Is Gracious',
+    presence: 'b',
+    bond: 'child',
+    summaryB: 'The most human name Uriel could have chosen. He is too young to remember Abel. Uriel will have to tell him who his father was — find words for a man who chose to die so that John could live.',
+  },
+  {
+    name: 'Noxiel',
+    title: 'Son — Darkness of God',
+    presence: 'b',
+    bond: 'child',
+    summaryB: 'Twin, younger. Born in spring, after Abel\'s death — conceived before it. He carries something dark in his eyes. Uriel names him for what she carries: the grief, the shadow the fixed point cast over everything.',
+  },
+  {
+    name: 'Sariel',
+    title: 'Son — Strength of God',
+    presence: 'b',
+    bond: 'child',
+    summaryB: 'Twin, younger. Loud, demanding, impossible to ignore. Uriel names him for what she needs to become. He is her instruction, written in the form of a child.',
+  },
+]
+
+const bondLabels: Record<Bond, string> = {
+  divine:   'Divine bond',
+  adversary: 'Adversary',
+  family:   'Family',
+  ally:     'Ally',
+  ward:     'Ward',
+  child:    'Child',
+}
+
+const presenceLabels: Record<Presence, string> = {
+  a:    'Timeline A only',
+  b:    'Timeline B only',
+  both: 'Both timelines',
+}
+
+type Filter = 'all' | Presence | Bond
+
+export default function Connections() {
+  const [active, setActive] = createSignal<string | null>(null)
+  const [filter, setFilter] = createSignal<Filter>('all')
+
+  const filters: { label: string; value: Filter }[] = [
+    { label: 'All', value: 'all' },
+    { label: 'Timeline A', value: 'a' },
+    { label: 'Timeline B', value: 'b' },
+    { label: 'Both timelines', value: 'both' },
+    { label: 'Family', value: 'family' },
+    { label: 'Divine', value: 'divine' },
+    { label: 'Ally', value: 'ally' },
+    { label: 'Ward', value: 'ward' },
+    { label: 'Child', value: 'child' },
+  ]
+
+  const filtered = () => {
+    const f = filter()
+    if (f === 'all') return connections
+    return connections.filter(c =>
+      c.presence === f ||
+      (f === 'both' && c.presence === 'both') ||
+      c.bond === f
+    )
+  }
+
+  const selected = () => connections.find(c => c.name === active()) ?? null
+
+  return (
+    <div class="cn-page">
+      {/* Header */}
+      <header class="page-header">
+        <A href="/" class="page-back">← Uriel</A>
+        <div class="page-title-group">
+          <p class="page-eyebrow">Archive — Relational record</p>
+          <h1 class="page-title">Connections</h1>
+          <p class="page-subtitle">Those who shaped her. Those she shaped.</p>
+        </div>
+        <div class="cn-header-right" />
+      </header>
+
+      {/* Filters */}
+      <div class="cn-filters">
+        <For each={filters}>
+          {f => (
+            <button
+              class="cn-filter-btn"
+              classList={{ 'is-active': filter() === f.value }}
+              onClick={() => setFilter(f.value)}
+            >
+              {f.label}
+            </button>
+          )}
+        </For>
+      </div>
+
+      {/* Grid + detail panel */}
+      <div class="cn-body">
+        <div class="cn-grid-wrapper">
+        <div class="cn-grid">
+          <For each={filtered()}>
+            {conn => (
+              <button
+                class="cn-card"
+                classList={{
+                  'is-selected': active() === conn.name,
+                  [`bond-${conn.bond}`]: true,
+                  [`presence-${conn.presence}`]: true,
+                }}
+                onClick={() => setActive(v => v === conn.name ? null : conn.name)}
+              >
+                <div class="cn-card-top">
+                  <span class="cn-bond-dot" aria-hidden="true" />
+                  <span class="cn-presence-tag">{presenceLabels[conn.presence]}</span>
+                </div>
+                <p class="cn-card-name">{conn.name}</p>
+                <p class="cn-card-title">{conn.title}</p>
+                <p class="cn-card-bond">{bondLabels[conn.bond]}</p>
+              </button>
+            )}
+          </For>
+        </div>
+        </div>
+
+        {/* Detail panel */}
+        <Show when={selected()}>
+          {conn => (
+            <aside class="cn-detail">
+              <div class="cn-detail-inner">
+                <button class="cn-detail-close" onClick={() => setActive(null)} aria-label="Close">✕</button>
+
+                <p class="cn-detail-eyebrow">{bondLabels[conn().bond]} &nbsp;·&nbsp; {presenceLabels[conn().presence]}</p>
+                <h2 class="cn-detail-name">{conn().name}</h2>
+                <p class="cn-detail-title">{conn().title}</p>
+
+                <div class="cn-detail-entries">
+                  <Show when={conn().summaryA}>
+                    <div class="cn-detail-entry">
+                      <span class="cn-entry-label cn-label-a">Timeline A</span>
+                      <p class="cn-entry-text">{conn().summaryA}</p>
+                    </div>
+                  </Show>
+                  <Show when={conn().summaryB}>
+                    <div class="cn-detail-entry">
+                      <span class="cn-entry-label cn-label-b">Timeline B</span>
+                      <p class="cn-entry-text">{conn().summaryB}</p>
+                    </div>
+                  </Show>
+                </div>
+
+                <Show when={conn().quote}>
+                  <blockquote class="cn-detail-quote">
+                    <p>{conn().quote}</p>
+                    <Show when={conn().quoteSource}>
+                      <cite>{conn().quoteSource}</cite>
+                    </Show>
+                  </blockquote>
+                </Show>
+              </div>
+            </aside>
+          )}
+        </Show>
+      </div>
+
+      <footer class="page-footer">
+        <p>Eden, Third Heaven &nbsp;·&nbsp; Archive of the Throne of Wisdom</p>
+      </footer>
+    </div>
+  )
+}
