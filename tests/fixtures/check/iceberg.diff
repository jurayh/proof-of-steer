+  background: var(--gold-100);
+  background-image:
+    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(251, 191, 36, 0.14) 0%, transparent 60%);
+  font-family: var(--font-body);
+  color: var(--text-primary);
+  display: flex;
+  flex-direction: column;
+}
+
+/* ── Main ───────────────────────────────────────────── */
+.bk-main {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 3rem 2rem;
+}
+
+.bk-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 1.5rem;
+  max-width: 900px;
+  width: 100%;
+}
+
+/* ── Card ───────────────────────────────────────────── */
+.bk-card {
+  background: rgba(255, 251, 240, 0.7);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 1.75rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+  transition: border-color var(--transition), box-shadow var(--transition);
+  position: relative;
+  overflow: hidden;
+}
+
+.bk-card::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 3px;
+}
+
+.bk-card.timeline-a::before { background: linear-gradient(90deg, #60a5fa, #93c5fd); }
+.bk-card.timeline-b::before { background: linear-gradient(90deg, #34d399, #6ee7b7); }
+
+.bk-card:hover {
+  border-color: rgba(245, 158, 11, 0.4);
+  box-shadow: 0 6px 28px rgba(13, 31, 60, 0.08);
+}
+
+/* ── Card top row ───────────────────────────────────── */
+.bk-card-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 0.25rem;
+}
+
+.bk-timeline-tag {
+  font-size: 0.62rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  padding: 0.15rem 0.55rem;
+  border-radius: 3px;
+}
+
+.bk-timeline-tag.timeline-a {
+  background: rgba(96, 165, 250, 0.15);
+  color: #1d4ed8;
+}
+
+.bk-timeline-tag.timeline-b {
+  background: rgba(52, 211, 153, 0.15);
+  color: #065f46;
+}
+
+.bk-status {
+  font-size: 0.62rem;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.bk-status.is-published { color: var(--gold-500); }
+.bk-status.is-forthcoming { color: var(--text-muted); opacity: 0.6; }
+
+/* ── Card content ───────────────────────────────────── */
+.bk-title {
+  font-family: var(--font-display);
+  font-size: 1.5rem;
+  font-weight: 300;
+  color: var(--amber-deep);
+  line-height: 1.2;
+  letter-spacing: 0.02em;
+}
+
+.bk-subtitle {
+  font-size: 0.7rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  margin-top: -0.2rem;
+}
+
+.bk-description {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 0.875rem;
+  line-height: 1.75;
+  color: var(--text-secondary);
+  margin-top: 0.5rem;
+  flex: 1;
+}
+
+/* ── Links ──────────────────────────────────────────── */
+.bk-links {
+  display: flex;
+  gap: 0.75rem;
+  margin-top: 0.75rem;
+  flex-wrap: wrap;
+}
+
+.bk-link {
+  display: inline-block;
+  padding: 0.45rem 1rem;
+  background: var(--gold-500);
+  color: #fff;
+  border-radius: 4px;
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-decoration: none;
+  transition: background var(--transition), transform var(--transition);
+}
+
+.bk-link:hover {
+  background: var(--gold-600);
+  transform: translateY(-1px);
+}
+
+/* ── Responsive ─────────────────────────────────────── */
+@media (max-width: 700px) {
+  .bk-grid { grid-template-columns: 1fr; }
+  .bk-main { padding: 2rem 1.5rem; align-items: flex-start; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .bk-card, .bk-link { transition: none; }
+}
