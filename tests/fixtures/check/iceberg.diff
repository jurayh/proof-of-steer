+import { createSignal, For, Show } from 'solid-js'
+import { A } from '@solidjs/router'
+import '../worldbuilding.css'
+
+interface Entry {
+  term: string
+  body: string
+  note?: string
+}
+
+interface Section {
+  id: string
+  heading: string
+  intro?: string
+  entries: Entry[]
+}
+
+const sections: Section[] = [
+  {
+    id: 'dimensions',
+    heading: 'The dimensions',
+    intro: 'Reality is not one place. It is at least three.',
+    entries: [
+      {
+        term: 'Heaven',
+        body: 'A metaphysical dimension, ever-expanding, infinite in size. Not a location but a state of being with geography. Angels speak loosely of an outer heaven and an inner heaven, numbered by depth — Eden sits in the Third Heaven. The archive occupies its own space: an infinite library of infinite scrolls and books, every human deed recorded in full fidelity.',
+      },
+      {
+        term: 'The mortal world',
+        body: 'The dimension of humanity. Subject to fixed points — events woven into the fabric of a timeline that cannot be changed without unraveling it. No one enforces fixed points. They simply are.',
+      },
+      {
+        term: 'Hell',
+        body: 'A separate dimension created by YHWH. Both punitive and retributive. Entry is not granted for petty theft or disbelief — only for repeated, sustained evil. Hell has nine rings, each governed by a fallen angel who shapes it as they see fit. One soul has left Hell in ten thousand years. Whether that is mercy or a flaw in the design is unresolved.',
+        note: 'Lucifer is the Warden of Hell — by punishment and by choice.',
+      },
+    ],
+  },
+  {
+    id: 'yhwh',
+    heading: 'YHWH',
+    intro: 'The Creator. She has a human form for general appearance, a material form for specific manifestations. Her true form is something else entirely.',
+    entries: [
+      {
+        term: 'The true form',
+        body: 'All-encompassing pure bright white light. Not horrifying — the word is insufficient. The experience is closer to mindbreak: the complete failure of a consciousness to process what it is witnessing. Those who have seen it do not describe it. They cannot.',
+      },
+      {
+        term: 'Her nature',
+        body: 'She argues for love that must be chosen. She creates Hell and also creates the possibility of leaving it. She judges Uriel harshly in Timeline B and then meets her eyes after — warmth, recognition, not forgiveness. She withdraws from creation after Cain\'s murder in Timeline A and remains withdrawn. The machinery runs without her.',
+      },
+    ],
+  },
+  {
+    id: 'angels',
+    heading: 'Angels',
+    intro: 'Two axes define every angel. Power is what they are. Role is what they do. The axes are independent.',
+    entries: [
+      {
+        term: 'Seraph',
+        body: 'The highest class. The strongest angels. Unlike the traditional image — the creatures crying holy, holy, holy — Seraphim here are defined by power alone. Michael and Lucifer (before the fall) are Seraphim. There is no performance of holiness. There is only what they can do.',
+      },
+      {
+        term: 'Throne',
+        body: 'The second class. Uriel is a Throne in both timelines at creation — diminished to Archangel-rank after the fall in Timeline B. Thrones are judges, archivists, the precise instruments of Heaven\'s administration.',
+      },
+      {
+        term: 'Dominion',
+        body: 'The third class. Raphael and Metatron are Dominions. The gap between Dominion and Throne is significant enough that Uriel considers Gabriel and Raphael unsuitable for the Grigori mission — not in capacity, but in nature.',
+      },
+      {
+        term: 'Cherub',
+        body: 'The fourth class. Gabriel is a Cherub. Cherubim are not the round-faced infants of later art. Gabriel is precise, reliable, extensive in human contact. His nature is motion: arrive, deliver, depart.',
+      },
+      {
+        term: 'Archangel',
+        body: 'The fifth class. The rank Uriel falls to in Timeline B after the judgment. The most visible class in human record — and not the most powerful. The gap between Archangel and Throne is not small.',
+      },
+      {
+        term: 'Paedorium',
+        body: 'The sixth and lowest class. From the Latin paedor — dirt. Angels closest to humanity in nature. No named Paedorium exist yet in the record.',
+      },
+    ],
+  },
+  {
+    id: 'roles',
+    heading: 'Roles',
+    intro: 'What an angel does is separate from what an angel is.',
+    entries: [
+      {
+        term: 'Grigori',
+        body: 'Watchers. Angels stationed to observe humanity up close — to fill what the archive cannot hold: the why behind the what. In Timeline A, Metatron proposes the Grigori mission and Uriel is assigned to assemble the team. It is never approved. In Timeline B, Uriel circumvents the need for approval entirely.',
+      },
+      {
+        term: 'Malakhim',
+        body: 'Messengers. The angels of human record — the ones who appear, speak, and leave. Gabriel is a Malakhim by nature even if not solely by assignment.',
+      },
+      {
+        term: 'Virtues',
+        body: 'Embodiments of divine attributes. Uriel is the Virtue of Wisdom and Judgement. Michael holds Fortitude and Justice. Raphael holds Temperance and Healing. Gabriel holds Faith and Kindness. A Virtue does not merely practice the attribute — they are its living instance in Heaven.',
+      },
+    ],
+  },
+  {
+    id: 'stewards',
+    heading: 'The five stewards',
+    intro: 'After the exile from Eden, YHWH expands the heavenly bureaucracy. Five angels are elevated as Stewards — the administrative spine of Heaven.',
+    entries: [
+      {
+        term: 'Michael',
+        body: 'Seraph. Virtue of Fortitude and Justice. Commander of Heaven\'s forces. Ash-grey wings, lighter in shade. He wins the War in Heaven in Timeline B. He and Uriel are not close — they operate in parallel, not in concert.',
+      },
+      {
+        term: 'Gabriel',
+        body: 'Cherub. Virtue of Faith and Kindness. Golden wings. His nature is motion — he carries messages between dimensions, tells Lucifer of Uriel\'s judgment in Timeline B. He does not stay anywhere long enough to be changed by it.',
+      },
+      {
+        term: 'Raphael',
+        body: 'Dominion. Virtue of Temperance and Healing. His first instinct when confronted with suffering is to mend. Uriel considers him for the Grigori mission and rules him out — a healer on a mission of non-interference is a contradiction.',
+      },
+      {
+        term: 'Metatron',
+        body: 'Dominion. Keeper of the Akashic Records. He proposes the Grigori mission in Timeline A — the mission that Uriel would have led. It is never approved. He does not appear in Timeline B.',
+      },
+      {
+        term: 'Uriel',
+        body: 'Throne. Virtue of Wisdom and Judgement. Darker grey wings in Timeline A — the wings of someone who has stood at a gate for centuries without moving. In Timeline B her wings are molting and dark after the fall, reduced to membranes stretched over bone. She is a Steward in Timeline A only. In Timeline B there is no title left to hold.',
+      },
+    ],
+  },
+  {
+    id: 'hell-rings',
+    heading: 'The nine rings',
+    intro: 'Hell has nine rings. Each is governed by a fallen angel who shapes it as they see fit. The wardens are the seven embodiments of sin, plus two.',
+    entries: [
+      {
+        term: 'Lucifer — Warden of Hell',
+        body: 'He does not embody Pride. Pride can be broken. Lucifer embodies Certainty — the absolute, unshakeable conviction that he was right. He governs all nine rings as Warden, by punishment and by choice. He promised Uriel the humans would survive. He kept that promise. He did not save her when she fell.',
+      },
+      {
+        term: 'Pride',
+        body: 'One of the seven sins. A separate fallen angel — distinct from Lucifer. Governs their ring as they see fit.',
+      },
+      {
+        term: 'Wrath · Envy · Sloth · Greed · Gluttony · Lust',
+        body: 'The remaining six sins. Each governs a ring of Hell shaped entirely by their nature. The architecture of each ring is the warden made visible.',
+      },
+      {
+        term: 'Azazel',
+        body: 'One of the two fallen angels beyond the seven sins. Governs the eighth ring. Domain defined — details withheld from the public record.',
+      },
+      {
+        term: 'Gadreel',
+        body: 'One of the two fallen angels beyond the seven sins. Governs the ninth ring. He uses it for souls he believes still have hope — those who might yet be redeemed. Whether this is mercy or presumption is his alone to answer.',
+      },
+    ],
+  },
+  {
+    id: 'wings',
+    heading: 'Wings & halos',
+    intro: 'All angels have wings and halos. Their appearance is not decorative — it is diagnostic. Rank, orientation, and behavior are all legible in the feathers.',
+    entries: [
+      {
+        term: 'Lucifer',
+        body: 'The whitest wings in Heaven. Before the fall.',
+      },
+      {
+        term: 'Gabriel',
+        body: 'Golden wings.',
+      },
+      {
+        term: 'Michael',
+        body: 'Lighter ash-grey wings.',
+      },
+      {
+        term: 'Uriel — Timeline A',
+        body: 'Darker grey wings. The wings of a guardian who has not moved from her post in centuries.',
+      },
+      {
+        term: 'Uriel — Timeline B',
+        body: 'Molting, dark. Tattered after the fall from Heaven. Reduced to membranes stretched over bone, folded beneath her tunic in the mortal world.',
+      },
+      {
+        term: 'The general rule',
+        body: 'Wing appearance reflects rank and the angel\'s nature. The full taxonomy has not yet been recorded.',
+      },
+    ],
+  },
+]
+
+export default function Worldbuilding() {
+  const [openSection, setOpenSection] = createSignal<string | null>('dimensions')
+
+  function toggle(id: string) {
+    setOpenSection(v => v === id ? null : id)
+  }
+
+  return (
+    <div class="wb-page">
+      <header class="page-header">
+        <A href="/" class="page-back">← Uriel</A>
+        <div class="page-title-group">
+          <p class="page-eyebrow">Archive — In-universe record</p>
+          <h1 class="page-title">Worldbuilding</h1>
+          <p class="page-subtitle">The architecture of a universe.</p>
+        </div>
+        <div />
+      </header>
+
+      <main class="wb-main">
+        <div class="wb-layout">
+          {/* Section nav */}
+          <nav class="wb-nav" aria-label="Sections">
+            <For each={sections}>
+              {s => (
+                <button
+                  class="wb-nav-item"
+                  classList={{ 'is-active': openSection() === s.id }}
+                  onClick={() => toggle(s.id)}
+                >
+                  {s.heading}
+                </button>
+              )}
+            </For>
+          </nav>
+
+          {/* Content */}
+          <div class="wb-content">
+            <For each={sections}>
+              {s => (
+                <Show when={openSection() === s.id}>
+                  <section class="wb-section">
+                    <div class="wb-section-header">
+                      <h2 class="wb-section-heading">{s.heading}</h2>
+                      {s.intro && <p class="wb-section-intro">{s.intro}</p>}
+                    </div>
+                    <div class="wb-entries">
+                      <For each={s.entries}>
+                        {entry => (
+                          <div class="wb-entry">
+                            <dt class="wb-term">{entry.term}</dt>
+                            <dd class="wb-body">{entry.body}</dd>
+                            {entry.note && <dd class="wb-note">{entry.note}</dd>}
+                          </div>
+                        )}
+                      </For>
+                    </div>
+                  </section>
+                </Show>
+              )}
+            </For>
+          </div>
+        </div>
+      </main>
+
+      <footer class="page-footer">
+        <p>Eden, Third Heaven &nbsp;·&nbsp; Archive of the Throne of Wisdom</p>
+      </footer>
+    </div>
+  )
+}
