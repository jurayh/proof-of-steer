+.viewport {
+  display: grid;
+  grid-template-columns: 200px 1fr 200px;
+  height: 100vh;
+  max-width: 1280px;
+  margin: 0 auto;
+  padding: 0 2rem;
+  overflow: hidden;
+}
+
+/* ── Left column ────────────────────────────────────── */
+.left-col {
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: flex-start;
+  padding: 3rem 1.5rem 3rem 0;
+  border-right: 1px solid var(--border);
+}
+
+.sigil {
+  width: 88px;
+  height: 88px;
+  color: var(--gold-500);
+  opacity: 0.85;
+  filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.4));
+}
+
+.side-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+}
+
+.nav-item {
+  font-size: 0.78rem;
+  font-weight: 400;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  text-decoration: none;
+  padding: 0.3rem 0.75rem;
+  border-left: 2px solid transparent;
+  transition: color var(--transition), border-color var(--transition);
+}
+
+.nav-item:hover,
+.nav-item.is-active {
+  color: var(--gold-500);
+  border-left-color: var(--gold-500);
+}
+
+.side-label {
+  font-size: 0.7rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  opacity: 0.6;
+}
+
+/* ── Center column ──────────────────────────────────── */
+.center-col {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  text-align: center;
+  padding: 3rem;
+  gap: 2.5rem;
+}
+
+.hero-header {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.6rem;
+}
+
+.eyebrow {
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: var(--gold-500);
+}
+
+.hero-name {
+  font-family: var(--font-hero);
+  font-size: clamp(4.5rem, 9vw, 8rem);
+  font-weight: 600;
+  font-style: italic;
+  line-height: 1;
+  letter-spacing: -0.01em;
+  color: var(--amber-deep);
+  text-shadow:
+    0 0 60px rgba(245, 158, 11, 0.35),
+    0 2px 4px rgba(0, 0, 0, 0.08);
+}
+
+.hero-epithet {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 1.1rem;
+  font-weight: 300;
+  color: var(--text-secondary);
+  letter-spacing: 0.04em;
+}
+
+.hero-quote {
+  border-left: none;
+  max-width: 38ch;
+}
+
+.hero-quote p {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 1.2rem;
+  font-weight: 300;
+  line-height: 1.75;
+  color: var(--text-secondary);
+  position: relative;
+}
+
+.hero-quote p::before {
+  content: '\201C';
+  position: absolute;
+  left: -1.2rem;
+  top: -0.25rem;
+  font-size: 2.5rem;
+  color: var(--gold-300);
+  line-height: 1;
+  font-family: var(--font-display);
+}
+
+.hero-quote p::after {
+  content: '\201D';
+  font-size: 2.5rem;
+  color: var(--gold-300);
+  line-height: 0;
+  vertical-align: -0.6rem;
+  font-family: var(--font-display);
+  margin-left: 0.15rem;
+}
+
+.hero-cta-row {
+  display: flex;
+  gap: 1rem;
+  align-items: center;
+}
+
+/* ── Buttons ────────────────────────────────────────── */
+.btn-primary {
+  display: inline-block;
+  padding: 0.65rem 1.75rem;
+  background: var(--gold-500);
+  color: #fff;
+  border: none;
+  border-radius: 4px;
+  font-size: 0.85rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-decoration: none;
+  cursor: pointer;
+  box-shadow: 0 2px 12px rgba(217, 119, 6, 0.4);
+  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
+}
+
+.btn-primary:hover {
+  background: var(--gold-600);
+  transform: translateY(-1px);
+  box-shadow: 0 4px 18px rgba(217, 119, 6, 0.5);
+}
+
+.btn-ghost {
+  display: inline-block;
+  padding: 0.65rem 1.5rem;
+  background: transparent;
+  color: var(--text-secondary);
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  font-size: 0.85rem;
+  font-family: var(--font-body);
+  font-weight: 500;
+  text-decoration: none;
+  transition: border-color var(--transition), color var(--transition);
+}
+
+.btn-ghost:hover {
+  border-color: var(--gold-400);
+  color: var(--gold-600);
+}
+
+/* ── Right column ───────────────────────────────────── */
+.right-col {
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: flex-end;
+  padding: 3rem 0 3rem 1.5rem;
+  border-left: 1px solid var(--border);
+}
+
+.attributes {
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+  align-items: flex-end;
+}
+
+.attr {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 0.15rem;
+}
+
+.attr-label {
+  font-size: 0.65rem;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  opacity: 0.7;
+}
+
+.attr-value {
+  font-family: var(--font-display);
+  font-size: 0.9rem;
+  font-style: italic;
+  color: var(--text-secondary);
+}
+
+.scroll-ornament {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.5rem;
+  color: var(--gold-400);
+  opacity: 0.6;
+}
+
+.ornament-line {
+  display: block;
+  width: 1px;
+  height: 40px;
+  background: currentColor;
+}
+
+.ornament-glyph { font-size: 0.75rem; }
+
+.right-label {
+  font-size: 0.7rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  opacity: 0.6;
+  writing-mode: vertical-rl;
+  text-orientation: mixed;
+  transform: rotate(180deg);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn-primary, .btn-ghost, .nav-item { transition: none; }
+}
diff --git a/IceBerg/src/index.css b/IceBerg/src/index.css
