@@ -0,0 +1,181 @@
+.wb-page {
+  min-height: 100vh;
+  background: var(--gold-100);
+  background-image:
+    radial-gradient(ellipse 80% 50% at 50% 0%, rgba(251, 191, 36, 0.14) 0%, transparent 60%);
+  font-family: var(--font-body);
+  color: var(--text-primary);
+  display: flex;
+  flex-direction: column;
+}
+
+/* ── Main layout ────────────────────────────────────── */
+.wb-main {
+  flex: 1;
+  padding: 2.5rem 3rem 4rem;
+  max-width: 1100px;
+  margin: 0 auto;
+  width: 100%;
+}
+
+.wb-layout {
+  display: grid;
+  grid-template-columns: 200px 1fr;
+  gap: 3rem;
+  align-items: start;
+}
+
+/* ── Section nav ────────────────────────────────────── */
+.wb-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+  position: sticky;
+  top: 6rem;
+}
+
+.wb-nav-item {
+  text-align: left;
+  background: transparent;
+  border: none;
+  border-left: 2px solid transparent;
+  padding: 0.4rem 0.75rem;
+  font-size: 0.78rem;
+  font-family: var(--font-body);
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--text-muted);
+  cursor: pointer;
+  transition: color var(--transition), border-color var(--transition);
+}
+
+.wb-nav-item:hover {
+  color: var(--gold-500);
+}
+
+.wb-nav-item.is-active {
+  color: var(--gold-500);
+  border-left-color: var(--gold-500);
+}
+
+/* ── Section content ────────────────────────────────── */
+.wb-section {
+  animation: wb-fade-in 200ms ease;
+}
+
+@keyframes wb-fade-in {
+  from { opacity: 0; transform: translateY(6px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+
+.wb-section-header {
+  margin-bottom: 2rem;
+  padding-bottom: 1.25rem;
+  border-bottom: 1px solid var(--border);
+}
+
+.wb-section-heading {
+  font-family: var(--font-display);
+  font-size: 2.25rem;
+  font-weight: 300;
+  color: var(--amber-deep);
+  letter-spacing: 0.04em;
+  line-height: 1;
+  margin-bottom: 0.6rem;
+  text-transform: capitalize;
+}
+
+.wb-section-intro {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 0.95rem;
+  color: var(--text-secondary);
+  line-height: 1.65;
+  max-width: 56ch;
+}
+
+/* ── Entries ────────────────────────────────────────── */
+.wb-entries {
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+
+.wb-entry {
+  display: grid;
+  grid-template-columns: 200px 1fr;
+  gap: 0 2rem;
+  padding: 1.1rem 0;
+  border-bottom: 1px solid var(--border);
+}
+
+.wb-entry:last-child { border-bottom: none; }
+
+.wb-term {
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--gold-600);
+  padding-top: 0.15rem;
+  line-height: 1.5;
+}
+
+.wb-body {
+  font-size: 0.9rem;
+  line-height: 1.75;
+  color: var(--text-primary);
+  font-style: normal;
+}
+
+.wb-note {
+  grid-column: 2;
+  margin-top: 0.5rem;
+  font-family: var(--font-display);
+  font-style: italic;
+  font-size: 0.82rem;
+  color: var(--text-secondary);
+  padding-left: 0.75rem;
+  border-left: 2px solid var(--gold-300);
+}
+
+/* ── Responsive ─────────────────────────────────────── */
+@media (max-width: 768px) {
+  .wb-main { padding: 1.5rem; }
+
+  .wb-layout {
+    grid-template-columns: 1fr;
+    gap: 1.5rem;
+  }
+
+  .wb-nav {
+    position: static;
+    flex-direction: row;
+    flex-wrap: wrap;
+    gap: 0.4rem;
+  }
+
+  .wb-nav-item {
+    border-left: none;
+    border-bottom: 2px solid transparent;
+    padding: 0.3rem 0.6rem;
+  }
+
+  .wb-nav-item.is-active {
+    border-left-color: transparent;
+    border-bottom-color: var(--gold-500);
+  }
+
+  .wb-entry {
+    grid-template-columns: 1fr;
+    gap: 0.35rem;
+  }
+
+  .wb-note { grid-column: 1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .wb-section { animation: none; }
+  .wb-nav-item { transition: none; }
+}
diff --git a/IceBerg/style.css b/IceBerg/style.css
new file mode 100644
index 0000000..76c2db7
--- /dev/null
+++ b/IceBerg/style.css
@@ -0,0 +1,444 @@
+/* Base reset & tokens */
+*, *::before, *::after {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+:root {
+  --color-bg: #f5f7fa;
+  --color-surface: #ffffff;
+  --color-deep: #0d1f3c;
+  --color-mid: #1a3a5c;
+  --color-ice: #a8d4f5;
+  --color-water: #2a6496;
+  --color-text: #1a1a2e;
+  --color-text-muted: #5a6a7e;
+  --color-accent: #1e6fa8;
+  --color-accent-hover: #155a8a;
+
+  --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --font-mono: "Courier New", Courier, monospace;
+
+  --space-xs: 0.5rem;
+  --space-sm: 1rem;
+  --space-md: 2rem;
+  --space-lg: 4rem;
+  --space-xl: 8rem;
+
+  --radius-sm: 6px;
+  --radius-md: 12px;
+  --radius-lg: 24px;
+
+  --shadow-card: 0 4px 24px rgba(13, 31, 60, 0.08);
+  --shadow-btn: 0 2px 8px rgba(30, 111, 168, 0.3);
+
+  --transition-fast: 150ms ease;
+  --transition-base: 250ms ease;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  font-family: var(--font-body);
+  font-size: 1rem;
+  line-height: 1.6;
+  color: var(--color-text);
+  background-color: var(--color-bg);
+}
+
+/* ── Navigation ─────────────────────────────────────── */
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 100;
+  background: rgba(245, 247, 250, 0.9);
+  backdrop-filter: blur(12px);
+  border-bottom: 1px solid rgba(168, 212, 245, 0.3);
+}
+
+.top-nav {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: var(--space-sm) var(--space-md);
+}
+
+.nav-logo {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--color-deep);
+  text-decoration: none;
+  letter-spacing: -0.02em;
+}
+
+.nav-links {
+  display: flex;
+  gap: var(--space-md);
+  list-style: none;
+}
+
+.nav-links a {
+  color: var(--color-text-muted);
+  text-decoration: none;
+  font-size: 0.95rem;
+  transition: color var(--transition-fast);
+}
+
+.nav-links a:hover {
+  color: var(--color-accent);
+}
+
+/* ── Hero ────────────────────────────────────────────── */
+.hero-section {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-lg);
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: var(--space-xl) var(--space-md);
+  min-height: 80vh;
+}
+
+.hero-content {
+  flex: 1;
+  max-width: 560px;
+}
+
+.hero-heading {
+  font-size: clamp(2.5rem, 6vw, 4.5rem);
+  font-weight: 800;
+  line-height: 1.1;
+  letter-spacing: -0.03em;
+  color: var(--color-deep);
+  margin-bottom: var(--space-sm);
+}
+
+.hero-subtext {
+  font-size: 1.2rem;
+  color: var(--color-text-muted);
+  margin-bottom: var(--space-md);
+  max-width: 42ch;
+}
+
+.hero-actions {
+  display: flex;
+  gap: var(--space-sm);
+  flex-wrap: wrap;
+}
+
+/* ── Iceberg visual ──────────────────────────────────── */
+.hero-visual {
+  flex: 1;
+  display: flex;
+  justify-content: center;
+  align-items: center;
+}
+
+.iceberg-shape {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  width: 240px;
+}
+
+.iceberg-tip {
+  width: 0;
+  height: 0;
+  border-left: 60px solid transparent;
+  border-right: 60px solid transparent;
+  border-bottom: 90px solid var(--color-ice);
+  filter: drop-shadow(0 -4px 12px rgba(168, 212, 245, 0.5));
+}
+
+.waterline {
+  width: 200px;
+  height: 3px;
+  background: linear-gradient(90deg, transparent, var(--color-water), transparent);
+  margin: 0;
+  position: relative;
+}
+
+.waterline::before {
+  content: '';
+  position: absolute;
+  inset: -8px -20px;
+  background: rgba(42, 100, 150, 0.08);
+  border-radius: 50%;
+  filter: blur(4px);
+}
+
+.iceberg-body {
+  width: 0;
+  height: 0;
+  border-left: 110px solid transparent;
+  border-right: 110px solid transparent;
+  border-top: 180px solid rgba(30, 111, 168, 0.25);
+  filter: blur(1px);
+}
+
+/* ── Buttons ─────────────────────────────────────────── */
+.btn-primary {
+  display: inline-block;
+  padding: 0.75rem 1.75rem;
+  background-color: var(--color-accent);
+  color: #fff;
+  border: none;
+  border-radius: var(--radius-sm);
+  font-size: 1rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  text-decoration: none;
+  cursor: pointer;
+  box-shadow: var(--shadow-btn);
+  transition: background-color var(--transition-fast), transform var(--transition-fast);
+}
+
+.btn-primary:hover {
+  background-color: var(--color-accent-hover);
+  transform: translateY(-1px);
+}
+
+.btn-primary:active {
+  transform: translateY(0);
+}
+
+.btn-secondary {
+  display: inline-block;
+  padding: 0.75rem 1.75rem;
+  background-color: transparent;
+  color: var(--color-accent);
+  border: 2px solid var(--color-accent);
+  border-radius: var(--radius-sm);
+  font-size: 1rem;
+  font-family: var(--font-body);
+  font-weight: 600;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color var(--transition-fast), color var(--transition-fast);
+}
+
+.btn-secondary:hover {
+  background-color: var(--color-accent);
+  color: #fff;
+}
+
+/* ── Sections ────────────────────────────────────────── */
+section {
+  padding: var(--space-lg) var(--space-md);
+}
+
+.section-heading {
+  font-size: clamp(1.75rem, 4vw, 2.5rem);
+  font-weight: 700;
+  color: var(--color-deep);
+  text-align: center;
+  margin-bottom: var(--space-lg);
+  letter-spacing: -0.02em;
+}
+
+/* ── Features ────────────────────────────────────────── */
+.features-section {
+  max-width: 1100px;
+  margin: 0 auto;
+}
+
+.feature-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: var(--space-md);
+}
+
+.feature-card {
+  background: var(--color-surface);
+  border-radius: var(--radius-md);
+  padding: var(--space-md);
+  box-shadow: var(--shadow-card);
+  border: 1px solid rgba(168, 212, 245, 0.2);
+  transition: transform var(--transition-base), box-shadow var(--transition-base);
+}
+
+.feature-card:hover {
+  transform: translateY(-4px);
+  box-shadow: 0 8px 32px rgba(13, 31, 60, 0.12);
+}
+
+.feature-icon {
+  font-size: 2rem;
+  color: var(--color-accent);
+  margin-bottom: var(--space-sm);
+}
+
+.feature-card h3 {
+  font-size: 1.2rem;
+  font-weight: 700;
+  color: var(--color-deep);
+  margin-bottom: var(--space-xs);
+}
+
+.feature-card p {
+  color: var(--color-text-muted);
+  line-height: 1.65;
+}
+
+/* ── About ───────────────────────────────────────────── */
+.about-section {
+  background: linear-gradient(135deg, var(--color-deep) 0%, var(--color-mid) 100%);
+  color: #fff;
+}
+
+.about-content {
+  max-width: 680px;
+  margin: 0 auto;
+  text-align: center;
+}
+
+.about-content h2 {
+  font-size: clamp(1.75rem, 4vw, 2.5rem);
+  font-weight: 700;
+  margin-bottom: var(--space-md);
+  letter-spacing: -0.02em;
+}
+
+.about-content p {
+  font-size: 1.1rem;
+  line-height: 1.75;
+  color: rgba(255, 255, 255, 0.8);
+  margin-bottom: var(--space-sm);
+}
+
+.about-content p:last-child {
+  font-size: 1.3rem;
+  font-weight: 600;
+  color: var(--color-ice);
+  margin-bottom: 0;
+}
+
+/* ── Contact ─────────────────────────────────────────── */
+.contact-section {
+  max-width: 560px;
+  margin: 0 auto;
+}
+
+.contact-form {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-sm);
+}
+
+.contact-form label {
+  font-size: 0.9rem;
+  font-weight: 600;
+  color: var(--color-text);
+  margin-bottom: -0.5rem;
+}
+
+.contact-form input,
+.contact-form textarea {
+  width: 100%;
+  padding: 0.75rem 1rem;
+  border: 1.5px solid rgba(168, 212, 245, 0.4);
+  border-radius: var(--radius-sm);
+  font-family: var(--font-body);
+  font-size: 1rem;
+  color: var(--color-text);
+  background: var(--color-surface);
+  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
+  resize: vertical;
+}
+
+.contact-form input:focus,
+.contact-form textarea:focus {
+  outline: none;
+  border-color: var(--color-accent);
+  box-shadow: 0 0 0 3px rgba(30, 111, 168, 0.15);
+}
+
+.contact-form .btn-primary {
+  align-self: flex-start;
+  margin-top: var(--space-xs);
+}
+
+/* ── Footer ──────────────────────────────────────────── */
+.site-footer {
+  text-align: center;
+  padding: var(--space-md);
+  color: var(--color-text-muted);
+  font-size: 0.875rem;
+  border-top: 1px solid rgba(168, 212, 245, 0.3);
+}
+
+/* ── Responsive ──────────────────────────────────────── */
+@media (max-width: 768px) {
+  .hero-section {
+    flex-direction: column;
+    padding: var(--space-lg) var(--space-sm);
+    min-height: auto;
+    text-align: center;
+  }
+
+  .hero-subtext {
+    margin-inline: auto;
+  }
+
+  .hero-actions {
+    justify-content: center;
+  }
+
+  .hero-visual {
+    order: -1;
+  }
+
+  .iceberg-shape {
+    width: 160px;
+  }
+
+  .iceberg-tip {
+    border-left-width: 40px;
+    border-right-width: 40px;
+    border-bottom-width: 60px;
+  }
+
+  .iceberg-body {
+    border-left-width: 75px;
+    border-right-width: 75px;
+    border-top-width: 120px;
+  }
+
+  .waterline {
+    width: 140px;
+  }
+
+  .top-nav {
+    padding: var(--space-sm);
+  }
+
+  .nav-links {
+    gap: var(--space-sm);
+  }
+}
+
+@media (max-width: 480px) {
+  .nav-links {
+    display: none;
+  }
+}
+
+/* ── Reduce motion ───────────────────────────────────── */
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  .feature-card,
+  .btn-primary,
+  .btn-secondary,
+  .nav-links a {
+    transition: none;
+  }
+}
