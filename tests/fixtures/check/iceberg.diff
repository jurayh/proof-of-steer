+import { createSignal, For, Show } from 'solid-js'
+import { A } from '@solidjs/router'
+import '../timelines.css'
+
+interface Beat {
+  title: string
+  summary: string
+  detail: string
+}
+
+interface Timeline {
+  id: string
+  label: string
+  eyebrow: string
+  descriptor: string
+  eyeColor: string
+  eyeColorHex: string
+  beats: Beat[]
+}
+
+const timelines: Timeline[] = [
+  {
+    id: 'a',
+    label: 'Timeline A',
+    eyebrow: 'Book of Beginnings → Book of Exile',
+    descriptor: 'The Faithful Recorder',
+    eyeColor: 'Blue',
+    eyeColorHex: '#60a5fa',
+    beats: [
+      {
+        title: 'Origin & creation',
+        summary: 'Created by YHWH and Lucifer as the fourth firstborn. Purpose woven into her sinew: Observer. Recorder. Neutral.',
+        detail: 'Lucifer shapes her with precision — still, unreadable, tall. Her eyes are the blue of deep water, of the space between stars. She does not smile. Her function is the archive: she moves through facets of frozen light, recording human deeds with perfect fidelity. She feels nothing — or almost nothing. A small, warm pressure lives in her marrow, in a place Lucifer\'s design did not reach. She does not name it. She does not know she can.',
+      },
+      {
+        title: 'The gap',
+        summary: 'The archive records actions but not why. A woman shares bread — the archive shows the act, not her reasoning. Uriel cannot file incomplete records.',
+        detail: 'She attends the council where YHWH and Lucifer debate free will. YHWH argues for love that must be chosen. Lucifer argues for order without suffering. Neither asks what humans actually need. Uriel stands at the edge, silent, but she names the gap internally: education. Free will without instruction is cruelty. She does not speak. She needs to be certain first.',
+      },
+      {
+        title: 'The proposal & the garden',
+        summary: 'Uriel proposes the Grigori mission: angels stationed on Earth to observe and report. It is never approved.',
+        detail: 'She is sent to guard the gate of Eden. She stands at the threshold, watching Adam and Eve. Eve draws her attention — the way she looks at the forbidden tree, not with hunger but with questions. Why is this one forbidden? What is on the other side? Uriel recognises herself in Eve\'s questioning. The small, warm pressure in her chest becomes recognition.',
+      },
+      {
+        title: 'Judgment & elevation',
+        summary: 'She does not interfere. After the exile, YHWH expands the heavenly bureaucracy. Uriel receives a flaming sword and becomes Guardian of Eden\'s gate.',
+        detail: 'She is no longer merely a recorder — she is a judge. Her eyes remain blue. She stands at the gate of paradise, determining which souls are worthy to enter. She judges without cruelty, without mercy, without attachment. The system works.',
+      },
+      {
+        title: 'The judgment of Cain',
+        summary: 'When Cain kills Abel, Uriel descends to pronounce judgment. She tells him the truth: there was no chosen. God does not speak in the silence.',
+        detail: 'She sees everything: Cain\'s years of watching, his certainty that Abel was favoured, the moment by the stream, the knife, Abel\'s dying question — why? She tells Cain the peace on Abel\'s face was not favour — it was contentment. Cain mistook ease for election. She curses him: the ground will not yield. He will be a fugitive and a wanderer. But she does not kill him. She marks him for protection and lets him walk away. She tells Eve that Abel is home. At peace. With the One who made him.',
+      },
+      {
+        title: 'Status at end of Timeline A',
+        summary: 'Guardian of Redeemed Eden. Holds the flaming sword of truth. Judges the souls of the righteous. Alone — but the system works.',
+        detail: 'She has no partner, no children, no life outside her function. She is alone — but she has made peace with that. She stands at the gate, watching the machinery of salvation turn. She is not cruel. She is not kind. She is exact.',
+      },
+    ],
+  },
+  {
+    id: 'b',
+    label: 'Timeline B',
+    eyebrow: 'Serpent of the Emerald Eye → Bloodline of Abel',
+    descriptor: 'The One Who Acts',
+    eyeColor: 'Green',
+    eyeColorHex: '#34d399',
+    beats: [
+      {
+        title: 'Origin & creation',
+        summary: 'Created the same way: Observer. Recorder. Neutral. Blue eyes. Still. Precise. She notices the same gap — the missing why.',
+        detail: 'The archive cannot hold incomplete records. The small, warm pressure lives in her marrow. She attends the same council. She names the same answer: education. But in this timeline, she does not wait to be certain. She acts.',
+      },
+      {
+        title: 'The decision',
+        summary: 'She does not propose a mission that will never be approved. She sees Eve standing before the forbidden tree, and she chooses to teach.',
+        detail: 'She transforms. Her blue eyes become green — the green of new leaves, of growing things, of the garden she is about to enter. Her form compacts, becomes sleeker, becomes the Green Vine Snake. She enters Eden and speaks to Eve in questions. "What is the purpose of a gift you are forbidden to open?" She teaches Eve that the tree contains knowledge — not evil, but information. That true obedience requires understanding. Eve eats with her eyes open. Adam eats to stay with her. The Fall is not a catastrophe. It is a lesson.',
+      },
+      {
+        title: 'Exile & the war',
+        summary: 'YHWH judges her harshly: You exceeded your function. The flaming sword is taken. She is exiled to the periphery, forbidden to teach again.',
+        detail: 'Lucifer recruits her for the rebellion. She agrees on one condition: the humans survive. She fights beside him, not as a general but as a judge wielding truth. On the battlefield, she hesitates — she cannot strike an angel she once worked beside. An enemy wounds her. She falls from Heaven. Her eyes remain green. The mark of what she has done.',
+      },
+      {
+        title: 'The fall & the forest',
+        summary: 'She lands broken in a field. Wings tattered, sword gone, flame out. She walks three months, starving, sleeping against trees, until she cannot walk anymore.',
+        detail: 'She sits against an oak and waits to die. Abel finds her. He is gathering berries. He sees her — a woman, too thin, too still, her clothes in rags. He does not ask who she is. He does not ask what she has done. He brings her bread. He carries her water. He takes her to the settlement.',
+      },
+      {
+        title: 'Life with Abel',
+        summary: 'Uriel recovers. She learns to be human — or something like it. She helps with the sheep. She learns to mend fences. She falls in love.',
+        detail: 'On a hillside, she tells Abel everything: the archive, the garden, the serpent. She was the one who taught Eve. She is the reason the world is hard. Abel thanks her. "You\'re the reason I exist at all." They marry. They have two children: Ariel (Lion of God) and John (God is gracious). The sheep know her. The children know her. For a time, she is almost happy.',
+      },
+      {
+        title: 'The fixed point',
+        summary: 'She has seen the records. She knows what is coming. She begs Abel to run. He refuses.',
+        detail: 'Breaking a fixed point could unravel reality — could hurt Ariel, John, everyone. He will not risk his family to save himself. He chooses to die. Uriel does not tell him about the twins. She does not know yet. They were conceived in the last days of his life, before the offering, before the meadow. Abel dies not knowing he is leaving two more children behind.',
+      },
+      {
+        title: 'The murder & after',
+        summary: 'Cain kills Abel by the stream. Uriel feels it — the thread of Abel\'s presence going slack, like a candle going out.',
+        detail: 'She does not scream. She walks to the meadow. She kneels beside him. She holds his hand. She does not kill Cain. She knows YHWH will handle it. She returns to the settlement. She holds Ariel and John. She does not explain. They are too young to understand.',
+      },
+      {
+        title: 'The twins',
+        summary: 'Weeks later, Uriel discovers she is pregnant. Noxiel (Darkness of God) and Sariel (Strength of God). He never knew.',
+        detail: 'She carries them through her grief, names them alone. She gives birth in the spring. Ariel meets her new brothers. John touches their tiny faces. Uriel sits in the darkness with all four children and begins the long work of raising them without him.',
+      },
+      {
+        title: 'Status at end of Timeline B',
+        summary: 'A widow. A mother of four. A fallen angel. Former Throne, now outside the system entirely. No function. No title. No rules binding her.',
+        detail: 'She has grief. She has children. She has the memory of a shepherd who found her in the forest and loved her until death. She does not know what she will become. She only knows she will keep going. For them. For him. For all of it.',
+      },
+    ],
+  },
+]
+
+const comparisonRows = [
+  { aspect: 'Origin', a: 'Observer. Recorder. Neutral.', b: 'Same.' },
+  { aspect: 'The gap', a: 'Notices it. Proposes Grigori mission. Never approved.', b: 'Notices it. Acts. Becomes the serpent.' },
+  { aspect: 'Eden', a: 'Watches from the gate. Does not interfere.', b: 'Enters as the Green Vine Snake. Teaches Eve.' },
+  { aspect: 'Judgment', a: 'Becomes Guardian of Eden\'s gate. Receives flaming sword.', b: 'Exiled to periphery. Sword removed. Forbidden to teach.' },
+  { aspect: 'War in Heaven', b: 'Fights beside Lucifer. Hesitates. Falls.', a: 'Does not participate.' },
+  { aspect: 'Marriage', a: 'None.', b: 'Marries Abel.' },
+  { aspect: 'Children', a: 'None.', b: 'Ariel, John, Noxiel, Sariel.' },
+  { aspect: 'Cain\'s murder', a: 'Pronounces judgment as an angel of the system.', b: 'Washes Abel\'s blood from her hands. Does not kill Cain.' },
+  { aspect: 'Status', a: 'Guardian of Eden. Judge. Alone.', b: 'Widow. Mother. Fallen. Surviving.' },
+  { aspect: 'Eyes', a: 'Blue.', b: 'Green.' },
+]
+
+export default function Timelines() {
+  const [openBeats, setOpenBeats] = createSignal<Set<string>>(new Set())
+  const [showComparison, setShowComparison] = createSignal(false)
+
+  function toggleBeat(key: string) {
+    setOpenBeats(prev => {
+      const next = new Set(prev)
+      next.has(key) ? next.delete(key) : next.add(key)
+      return next
+    })
+  }
+
+  return (
+    <div class="tl-page">
+      {/* Header */}
+      <header class="page-header">
+        <A href="/" class="page-back">← Uriel</A>
+        <div class="page-title-group">
+          <p class="page-eyebrow">Archive — In-universe record</p>
+          <h1 class="page-title">Timelines</h1>
+          <p class="page-subtitle">Two diverging paths. One soul.</p>
+        </div>
+        <button
+          class="tl-compare-toggle"
+          onClick={() => setShowComparison(v => !v)}
+          aria-expanded={showComparison()}
+        >
+          {showComparison() ? 'Hide comparison' : 'Compare timelines'}
+        </button>
+      </header>
+
+      {/* Comparison table */}
+      <Show when={showComparison()}>
+        <section class="tl-comparison">
+          <table class="compare-table">
+            <thead>
+              <tr>
+                <th class="col-aspect">Aspect</th>
+                <th class="col-a">Timeline A — Blue</th>
+                <th class="col-b">Timeline B — Green</th>
+              </tr>
+            </thead>
+            <tbody>
+              <For each={comparisonRows}>
+                {row => (
+                  <tr>
+                    <td class="cell-aspect">{row.aspect}</td>
+                    <td class="cell-a">{row.a}</td>
+                    <td class="cell-b">{row.b}</td>
+                  </tr>
+                )}
+              </For>
+            </tbody>
+          </table>
+        </section>
+      </Show>
+
+      {/* Timelines */}
+      <div class="tl-grid">
+        <For each={timelines}>
+          {(tl) => (
+            <section class="tl-column">
+              <div class="tl-col-header">
+                <div class="tl-eye-dot" style={{ background: tl.eyeColorHex }} aria-label={`Eye color: ${tl.eyeColor}`} />
+                <div>
+                  <h2 class="tl-col-label">{tl.label}</h2>
+                  <p class="tl-col-eyebrow">{tl.eyebrow}</p>
+                  <p class="tl-col-descriptor">{tl.descriptor}</p>
+                </div>
+              </div>
+
+              <div class="beats-list">
+                <For each={tl.beats}>
+                  {(beat, i) => {
+                    const key = `${tl.id}-${i()}`
+                    const isOpen = () => openBeats().has(key)
+                    return (
+                      <article class="beat-card" classList={{ 'is-open': isOpen() }}>
+                        <button class="beat-header" onClick={() => toggleBeat(key)} aria-expanded={isOpen()}>
+                          <span class="beat-index">{String(i() + 1).padStart(2, '0')}</span>
+                          <span class="beat-title">{beat.title}</span>
+                          <span class="beat-chevron" aria-hidden="true">{isOpen() ? '−' : '+'}</span>
+                        </button>
+                        <p class="beat-summary">{beat.summary}</p>
+                        <Show when={isOpen()}>
+                          <p class="beat-detail">{beat.detail}</p>
+                        </Show>
+                      </article>
+                    )
+                  }}
+                </For>
+              </div>
+            </section>
+          )}
+        </For>
+      </div>
+
+      <footer class="page-footer">
+        <p>Eden, Third Heaven &nbsp;·&nbsp; Archive of the Throne of Wisdom</p>
+      </footer>
+    </div>
+  )
+}
