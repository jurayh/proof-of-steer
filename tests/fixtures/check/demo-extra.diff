diff --git a/home/demo/reading-list/reading_list.py b/home/demo/reading-list/reading_list.py
new file mode 100644
index 0000000..57c1621
--- /dev/null
+++ b/home/demo/reading-list/reading_list.py
@@ -0,0 +1,17 @@
+#!/usr/bin/env python3
+import sys
+BOOKS = []
+def add(title):
+    BOOKS.append(title)
+    print("Added " + title + " to your list")
+def show():
+    for number, title in enumerate(BOOKS, 1):
+        print(str(number) + ". " + title)
+def main():
+    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
+    if cmd == "add":
+        add(sys.argv[2])
+    elif cmd == "list":
+        show()
+if __name__ == "__main__":
+    main()
diff --git a/home/demo/reading-list/test_reading_list.py b/home/demo/reading-list/test_reading_list.py
new file mode 100644
index 0000000..ba2a780
--- /dev/null
+++ b/home/demo/reading-list/test_reading_list.py
@@ -0,0 +1,11 @@
+import reading_list
+def test_add_appends_a_title():
+    reading_list.BOOKS.clear()
+    reading_list.add("Dune")
+    assert reading_list.BOOKS == ["Dune"]
+def test_show_prints_the_title(capsys):
+    reading_list.BOOKS[:] = []
+    reading_list.add("Emma")
+    reading_list.show()
+    out = capsys.readouterr().out
+    assert "Emma" in out
