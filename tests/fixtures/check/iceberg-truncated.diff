+import { A } from '@solidjs/router'
+import '../books.css'
+
+interface Book {
+  title: string
+  subtitle: string
+  timeline: string
+  status: 'published' | 'forthcoming'
+  description: string
+  links?: { label: string; url: string }[]
+}
+
+const books: Book[] = [
+  {
+    title: 'Book of Beginnings',
+    subtitle: 'Timeline A — Vol. I',
+    timeline: 'A',
+    status: 'published',
+    description:
+      'The origin. YHWH and Lucifer create the firstborn angels. Uriel takes her post as the recorder, the observer, the neutral. She watches Adam and Eve in the garden. She watches the Fall. She stands at the gate with a flaming sword and learns what it means to judge.',
+    links: [
+      { label: 'Amazon', url: 'https://www.amazon.in/dp/B0H12T8MZ6' },
+      { label: 'Goodreads', url: 'https://www.goodreads.com/book/show/252340071.Book_of_Beginnings' },
+    ],
+  },
+  {
+    title: 'Book of Exile',
+    subtitle: 'Timeline A — Vol. II',
+    timeline: 'A',
+    status: 'forthcoming',
+    description:
+      'The continuation of Timeline A. Uriel at the gate of Redeemed Eden, holding the sword of truth, judging the souls of the righteous. The machinery of salvation turns. She is alone — and the system works.',
+  },
+  {
+    title: 'Serpent of the Emerald Eye',
+    subtitle: 'Timeline B — Vol. I',
+    timeline: 'B',
+    status: 'forthcoming',
+    description:
+      'The divergence. Uriel sees Eve before the forbidden tree and makes a choice: she will teach. She becomes the Green Vine Snake, enters Eden, and speaks in questions. The Fall is not a catastrophe. It is a lesson — and it costs Uriel everything.',
+  },
+  {
+    title: 'Bloodline of Abel',
+    subtitle: 'Timeline B — Vol. II',
+    timeline: 'B',
+    status: 'forthcoming',
+    description:
+      'A fallen angel. A shepherd who asks nothing. A marriage, four children, and a fixed point that cannot be broken. Abel chooses to die. Uriel carries the twins alone through grief, and begins the long work of raising them without him.',
+  },
+]
+
+export default function Books() {
+  return (
+    <div class="bk-page">
+      <header class="page-header">
+        <A href="/" class="page-back">← Uriel</A>
+        <div class="page-title-group">
+          <p class="page-eyebrow">Archive — Published works</p>
+          <h1 class="page-title">The Books</h1>
+          <p class="page-subtitle">Four volumes. Two timelines. One soul.</p>
+        </div>
+        <div />
+      </header>
+
+      <main class="bk-main">
+        <div class="bk-grid">
+          {books.map(book => (
+            <article class={`bk-card timeline-${book.timeline.toLowerCase()}`}>
+              <div class="bk-card-top">
+                <span class={`bk-timeline-tag timeline-${book.timeline.toLowerCase()}`}>
+                  Timeline {book.timeline}
+                </span>
+                <span class={`bk-status is-${book.status}`}>
+                  {book.status === 'published' ? 'Available now' : 'Forthcoming'}
+                </span>
+              </div>
+
+              <h2 class="bk-title">{book.title}</h2>
+              <p class="bk-subtitle">{book.subtitle}</p>
+
+              <p class="bk-description">{book.description}</p>
+
+              {book.links && (
+                <div class="bk-links">
+                  {book.links.map(link => (
+                    <a
+                      href={link.url}
+                      class="bk-link"
+                      target="_blank"
+                      rel="noopener noreferrer"
+                    >
+                      {link.label} ↗
+                    </a>
+                  ))}
+                </div>
+              )}
+            </article>
+          ))}
+        </div>
+      </main>
+
+      <footer class="page-footer">
+        <p>Eden, Third Heaven &nbsp;·&nbsp; Archive of the Throne of Wisdom</p>
+      </footer>
+    </div>
+  )
+}
